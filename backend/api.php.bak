 if($action==='upload_product_image'){
   if(empty($_FILES['imagen']) || !is_uploaded_file($_FILES['imagen']['tmp_name'])) out(['ok'=>false,'message'=>'Selecciona una imagen válida.'],422);
   $f=$_FILES['imagen'];
   if($f['error']!==UPLOAD_ERR_OK) out(['ok'=>false,'message'=>'No se pudo subir la imagen.'],400);
   if($f['size']>5*1024*1024) out(['ok'=>false,'message'=>'La imagen no puede superar 5 MB.'],422);
   $mime=(new finfo(FILEINFO_MIME_TYPE))->file($f['tmp_name']);
   $allowed=['image/png'=>'png','image/jpeg'=>'jpg','image/webp'=>'webp','image/gif'=>'gif'];
   if(!isset($allowed[$mime])) out(['ok'=>false,'message'=>'Formato no permitido. Usa PNG, JPG, WEBP o GIF.'],422);
   $dir=__DIR__.'/../assets/uploads'; if(!is_dir($dir)) mkdir($dir,0775,true);
   $name='producto-'.date('YmdHis').'-'.bin2hex(random_bytes(4)).'.'.$allowed[$mime];
   if(!move_uploaded_file($f['tmp_name'],$dir.'/'.$name)) out(['ok'=>false,'message'=>'No se pudo guardar la imagen.'],500);
   out(['ok'=>true,'img'=>'assets/uploads/'.$name,'message'=>'Imagen subida correctamente.']);
 }
 if($action==='update_product'){
   $b=body();$id=(int)($b['id']??0);$name=trim($b['name']??'');$brand=trim($b['brand']??'');$cat=trim($b['cat']??'');$desc=trim($b['desc']??'');$price=(float)($b['price']??0);$stock=max(0,(int)($b['stock']??0));$img=trim($b['img']??'');$estado=trim($b['estado']??'Disponible');
   if(!$id||$name===''||$cat===''||$price<0)out(['ok'=>false,'message'=>'Datos de producto inválidos.'],422);
   if(!in_array($brand,['OMNILIFE','SEYTÚ'],true)){
     $qb=db()->prepare('SELECT marca FROM productos WHERE id_producto=?');$qb->execute([$id]);$brand=(string)($qb->fetchColumn()?:($id>=13?'SEYTÚ':'OMNILIFE'));
   }
   $s=db()->prepare('UPDATE productos SET nombre=?, marca=?, categoria=?, descripcion=?, precio=?, stock=?, imagen=?, estado=? WHERE id_producto=?');
   $s->execute([$name,$brand,$cat,$desc,$price,$stock,$img,$estado,$id]);
   ensureAdminSchema(); db()->prepare('INSERT IGNORE INTO categorias_producto(marca,nombre) VALUES(?,?)')->execute([$brand,$cat]);
   if($s->rowCount()===0){$q=db()->prepare('SELECT id_producto FROM productos WHERE id_producto=?');$q->execute([$id]);if(!$q->fetch())out(['ok'=>false,'message'=>'Producto no encontrado.'],404);}
   $q=db()->prepare('SELECT id_producto AS id,nombre AS name,marca AS brand,categoria AS cat,descripcion AS `desc`,precio AS price,stock,imagen AS img,estado FROM productos WHERE id_producto=?');$q->execute([$id]);$r=$q->fetch();$r['id']=(int)$r['id'];$r['price']=(float)$r['price'];$r['stock']=(int)$r['stock'];$r['img']=canonicalProductImage($r['id'],$r['img']);$r['brand']=($r['brand']??'')?:($r['id']>=13?'SEYTÚ':'OMNILIFE');$r['tone']=$r['brand']==='SEYTÚ'?'seytu':'omni';
   out(['ok'=>true,'product'=>$r,'message'=>'Producto actualizado en la base de datos.']);
 }
 if($action==='create_product'){
   ensureAdminSchema();
   $b=body();$name=trim($b['name']??'Nuevo producto');$brand=trim($b['brand']??'OMNILIFE');$brand=in_array($brand,['OMNILIFE','SEYTÚ'],true)?$brand:'OMNILIFE';$cat=trim($b['cat']??'');$desc=trim($b['desc']??'');$price=max(0,(float)($b['price']??0));$stock=max(0,(int)($b['stock']??0));$img=trim($b['img']??'');$estado=trim($b['estado']??'Disponible');
   if($name==='')out(['ok'=>false,'message'=>'El nombre del producto es obligatorio.'],422);
   if($cat==='')out(['ok'=>false,'message'=>'Selecciona o crea una categoría para '.$brand.'.'],422);
   $s=db()->prepare('INSERT INTO productos(nombre,marca,categoria,descripcion,precio,stock,imagen,estado) VALUES(?,?,?,?,?,?,?,?)');$s->execute([$name,$brand,$cat,$desc,$price,$stock,$img,$estado]);$id=(int)db()->lastInsertId();
   db()->prepare('INSERT IGNORE INTO categorias_producto(marca,nombre) VALUES(?,?)')->execute([$brand,$cat]);
   if($img===''){
      $candidate='assets/IMG/imagen-'.str_pad((string)$id,2,'0',STR_PAD_LEFT).'.png';
      if($id>=1 && $id<=60 && is_file(__DIR__.'/../'.$candidate)){
         db()->prepare('UPDATE productos SET imagen=? WHERE id_producto=?')->execute([$candidate,$id]);
         $img=$candidate;
      }
   }
   out(['ok'=>true,'id'=>$id,'img'=>$img,'message'=>'Producto creado en la base de datos.'],201);
 }
 if($action==='delete_product'){
  $b=body();
  $id=(int)($b['id']??0);
  if(!$id) out(['ok'=>false,'message'=>'Producto requerido.'],422);
  $q=db()->prepare('SELECT id_producto,nombre FROM productos WHERE id_producto=?');
  $q->execute([$id]);
  $p=$q->fetch();
  if(!$p) out(['ok'=>false,'message'=>'Producto no encontrado.'],404);
  // Eliminación lógica: conserva pedidos históricos y evita romper claves foráneas.
  $s=db()->prepare("UPDATE productos SET estado='Oculto' WHERE id_producto=?");
  $s->execute([$id]);
  out(['ok'=>true,'id'=>$id,'message'=>'Producto quitado del catálogo.']);
}
 if($action==='categories'){
   ensureAdminSchema();
   $brand=trim($_GET['brand']??'');
   if($brand!=='' && !in_array($brand,['OMNILIFE','SEYTÚ'],true)) out(['ok'=>false,'message'=>'Marca inválida.'],422);
   if($brand===''){
     $rows=db()->query("SELECT nombre FROM categorias_producto UNION SELECT DISTINCT categoria AS nombre FROM productos WHERE categoria IS NOT NULL AND TRIM(categoria)<>'' ORDER BY nombre")->fetchAll();
   }else{
     $q=db()->prepare("SELECT nombre FROM categorias_producto WHERE marca=? UNION SELECT DISTINCT categoria AS nombre FROM productos WHERE marca=? AND categoria IS NOT NULL AND TRIM(categoria)<>'' ORDER BY nombre");
     $q->execute([$brand,$brand]); $rows=$q->fetchAll();
   }
   $cats=[]; foreach($rows as $r){$n=trim((string)$r['nombre']);if($n!=='' && !in_array($n,$cats,true))$cats[]=$n;}
   natcasesort($cats); $cats=array_values($cats);
   out(['ok'=>true,'brand'=>$brand,'categories'=>$cats]);
 }
 if($action==='create_category'){
   ensureAdminSchema();
   $b=body(); $brand=trim($b['brand']??''); $name=trim($b['name']??'');
   if(!in_array($brand,['OMNILIFE','SEYTÚ'],true))out(['ok'=>false,'message'=>'Selecciona OMNILIFE o SEYTÚ.'],422);
   if($name==='' || mb_strlen($name)>100)out(['ok'=>false,'message'=>'Escribe un nombre de categoría válido.'],422);
   $q=db()->prepare('SELECT id_categoria,nombre FROM categorias_producto WHERE marca=? AND LOWER(nombre)=LOWER(?) LIMIT 1');$q->execute([$brand,$name]);
   $existing=$q->fetch();
   if($existing)out(['ok'=>true,'id_categoria'=>(int)$existing['id_categoria'],'name'=>$existing['nombre'],'created'=>false,'message'=>'La categoría ya existe.']);
   try{
     $s=db()->prepare('INSERT INTO categorias_producto(marca,nombre) VALUES(?,?)');$s->execute([$brand,$name]);
     out(['ok'=>true,'id_categoria'=>(int)db()->lastInsertId(),'name'=>$name,'created'=>true,'message'=>'Categoría creada correctamente.'],201);
   }catch(Throwable $e){out(['ok'=>false,'message'=>'No se pudo crear la categoría.','detalle'=>$e->getMessage()],500);}
 }
 if($action==='favorites'){
   ensureAdminAccount();
   $uid=(int)($_GET['id_usuario']??0);
   if(!$uid)out(['ok'=>false,'message'=>'Usuario requerido.'],422);
   $q=db()->prepare('SELECT id_producto FROM favoritos WHERE id_usuario=? ORDER BY fecha_guardado DESC');$q->execute([$uid]);
   $ids=array_map('intval',$q->fetchAll(PDO::FETCH_COLUMN));
   out(['ok'=>true,'favorites'=>$ids]);
 }
 if($action==='favorite_add'){
   ensureAdminAccount();
   $b=body();$uid=(int)($b['id_usuario']??0);$pid=(int)($b['id_producto']??0);
   if(!$uid||!$pid)out(['ok'=>false,'message'=>'Usuario y producto son requeridos.'],422);
   $u=db()->prepare('SELECT id_usuario FROM usuarios WHERE id_usuario=?');$u->execute([$uid]);if(!$u->fetch())out(['ok'=>false,'message'=>'Usuario no encontrado.'],404);
   $p=db()->prepare('SELECT id_producto FROM productos WHERE id_producto=?');$p->execute([$pid]);if(!$p->fetch())out(['ok'=>false,'message'=>'Producto no encontrado.'],404);
   db()->prepare('INSERT IGNORE INTO favoritos(id_usuario,id_producto) VALUES(?,?)')->execute([$uid,$pid]);
   out(['ok'=>true,'favorite'=>true,'id_producto'=>$pid]);
 }
 if($action==='favorite_remove'){
   ensureAdminAccount();
   $b=body();$uid=(int)($b['id_usuario']??0);$pid=(int)($b['id_producto']??0);
   if(!$uid||!$pid)out(['ok'=>false,'message'=>'Usuario y producto son requeridos.'],422);
   db()->prepare('DELETE FROM favoritos WHERE id_usuario=? AND id_producto=?')->execute([$uid,$pid]);
   out(['ok'=>true,'favorite'=>false,'id_producto'=>$pid]);
 }
 if($action==='favorites_clear'){
   ensureAdminAccount();
   $b=body();$uid=(int)($b['id_usuario']??0);if(!$uid)out(['ok'=>false,'message'=>'Usuario requerido.'],422);
   db()->prepare('DELETE FROM favoritos WHERE id_usuario=?')->execute([$uid]);out(['ok'=>true]);
 }
 if($action==='admin_favorites'){
   ensureAdminAccount();
   $rows=db()->query("SELECT f.id_producto AS id,p.nombre AS name,p.marca AS brand,p.imagen AS img,COUNT(*) AS total FROM favoritos f JOIN productos p ON p.id_producto=f.id_producto GROUP BY f.id_producto,p.nombre,p.marca,p.imagen ORDER BY total DESC,p.nombre ASC")->fetchAll();
   foreach($rows as &$r){$r['id']=(int)$r['id'];$r['total']=(int)$r['total'];$r['img']=canonicalProductImage($r['id'],$r['img']);}
   out(['ok'=>true,'favorites'=>$rows]);
 }
if($action==='products'){
   $rows=db()->query("SELECT id_producto AS id,nombre AS name,marca AS brand,categoria AS cat,descripcion AS `desc`,precio AS price,stock,imagen AS img,estado FROM productos WHERE estado <> 'Oculto' ORDER BY id_producto")->fetchAll();
   foreach($rows as &$r){$r['id']=(int)$r['id'];$r['price']=(float)$r['price'];$r['stock']=(int)$r['stock'];$r['img']=canonicalProductImage($r['id'],$r['img']);$r['brand']=in_array(($r['brand']??''),['OMNILIFE','SEYTÚ'],true)?$r['brand']:(((int)$r['id']>=13)?'SEYTÚ':'OMNILIFE');$r['tone']=$r['brand']==='SEYTÚ'?'seytu':'omni';}
   out(['ok'=>true,'products'=>$rows]);
 }
 if ($action === 'health') {
    try {
        $pdo = db();

        $pdo->query("SELECT 1");

        out([
            'ok' => true,
            'message' => 'Conexión con la base de datos correcta.'
        ]);
    } catch (Throwable $e) {
        out([
            'ok' => false,
            'message' => 'Error de conexión con la base de datos.',
            'detalle' => $e->getMessage()
        ], 500);
    }
}
 if($action==='create_order'){
   $b=body();$uid=(int)($b['id_usuario']??0);$items=$b['items']??[];$payment=trim($b['payment']??'');$email=trim($b['email']??'');
   if(!$uid||!is_array($items)||!count($items))out(['ok'=>false,'message'=>'Pedido inválido.'],422);if(!userById($uid))out(['ok'=>false,'message'=>'Usuario no encontrado.'],404);
   $pdo=db();$pdo->beginTransaction();try{
     $total=0;$normalized=[];
     foreach($items as $i){$pid=(int)($i['id']??0);$qty=max(1,(int)($i['qty']??1));$s=$pdo->prepare('SELECT * FROM productos WHERE id_producto=? FOR UPDATE');$s->execute([$pid]);$p=$s->fetch();if(!$p||$p['stock']<$qty)throw new Exception('Stock insuficiente para '.($p['nombre']??'producto').'.');$sub=(float)$p['precio']*$qty;$total+=$sub;$normalized[]=['p'=>$p,'qty'=>$qty,'sub'=>$sub];}
     $s=$pdo->prepare('INSERT INTO pedidos(id_usuario,total,estado,metodo_pago,correo_comprobante) VALUES(?,?,?,?,?)');$s->execute([$uid,$total,'Confirmado',$payment,$email]);$orderId=(int)$pdo->lastInsertId();
     $d=$pdo->prepare('INSERT INTO detalle_pedido(id_pedido,id_producto,cantidad,precio_unitario,subtotal) VALUES(?,?,?,?,?)');$up=$pdo->prepare('UPDATE productos SET stock=stock-? WHERE id_producto=?');
     foreach($normalized as $x){$p=$x['p'];$d->execute([$orderId,$p['id_producto'],$x['qty'],$p['precio'],$x['sub']]);$up->execute([$x['qty'],$p['id_producto']]);}
     $pdo->commit();out(['ok'=>true,'id_pedido'=>$orderId,'total'=>$total]);
   }catch(Throwable $e){$pdo->rollBack();out(['ok'=>false,'message'=>$e->getMessage()],400);}
 }
 if($action==='update_order_status'){ensureOrderColumns();$b=body();$id=(int)($b['id_pedido']??0);$estado=trim($b['estado']??'Pendiente');$visto=(int)($b['visto']??0);if(!$id)out(['ok'=>false,'message'=>'Pedido requerido.'],422);db()->prepare('UPDATE pedidos SET estado=?,visto=? WHERE id_pedido=?')->execute([$estado,$visto,$id]);out(['ok'=>true]);}
 if($action==='admin_orders'){ensureOrderColumns();$rows=db()->query("SELECT p.id_pedido,p.fecha_pedido,p.total,p.estado,p.visto,p.metodo_pago,p.correo_comprobante,CONCAT(COALESCE(u.nombres,''),' ',COALESCE(u.apellidos,'')) AS cliente FROM pedidos p LEFT JOIN usuarios u ON u.id_usuario=p.id_usuario ORDER BY p.fecha_pedido DESC")->fetchAll();foreach($rows as &$o){$d=db()->prepare('SELECT dp.id_producto AS id,p.nombre AS name,p.marca AS brand,p.categoria AS cat,p.imagen AS img,dp.precio_unitario AS price,dp.cantidad AS qty,dp.subtotal FROM detalle_pedido dp JOIN productos p ON p.id_producto=dp.id_producto WHERE dp.id_pedido=?');$d->execute([$o['id_pedido']]);$o['items']=$d->fetchAll();$o['total']=(float)$o['total'];}out(['ok'=>true,'orders'=>$rows]);}
 if($action==='orders'){
   $uid=(int)($_GET['id_usuario']??0);if(!$uid)out(['ok'=>false,'message'=>'Usuario requerido.'],422);
   $s=db()->prepare('SELECT id_pedido,fecha_pedido,total,estado,metodo_pago,correo_comprobante,visto FROM pedidos WHERE id_usuario=? ORDER BY fecha_pedido DESC');$s->execute([$uid]);$orders=$s->fetchAll();
   foreach($orders as &$o){$d=db()->prepare('SELECT dp.id_producto AS id,p.nombre AS name,p.marca AS brand,p.categoria AS cat,p.imagen AS img,dp.precio_unitario AS price,dp.cantidad AS qty,dp.subtotal FROM detalle_pedido dp JOIN productos p ON p.id_producto=dp.id_producto WHERE dp.id_pedido=?');$d->execute([$o['id_pedido']]);$o['items']=$d->fetchAll();$o['total']=(float)$o['total'];}
   out(['ok'=>true,'orders'=>$orders]);
 }
 if ($action === 'health') {
