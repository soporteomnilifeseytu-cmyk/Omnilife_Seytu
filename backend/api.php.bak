 if($action==='create_user'){
   ensureAdminSchema();
   $b=body();
   $n=trim($b['nombres']??''); $a=trim($b['apellidos']??''); $username=strtolower(trim($b['usuario']??'')); $email=strtolower(trim($b['correo']??'')); $phone=trim($b['telefono']??''); $pass=(string)($b['clave']??'123456');
   ensureUserUsernameColumn(); ensureUserRoleColumn();
   $role=($b['rol']??'cliente')==='admin'?'admin':'cliente';
   if(!$n||!preg_match('/^[a-z0-9._-]{3,30}$/',$username)||!filter_var($email,FILTER_VALIDATE_EMAIL)||strlen($pass)<6) out(['ok'=>false,'message'=>'Datos de usuario inválidos.'],422);
   if(userByEmail($email)) out(['ok'=>false,'message'=>'Ese correo ya está registrado.'],409);
   $q=db()->prepare('SELECT id_usuario FROM usuarios WHERE LOWER(usuario)=?');$q->execute([$username]);if($q->fetch())out(['ok'=>false,'message'=>'Ese usuario ya está registrado.'],409);
   $h=password_hash($pass,PASSWORD_DEFAULT);
   $s=db()->prepare('INSERT INTO usuarios(nombres,apellidos,usuario,correo,clave,telefono,rol) VALUES(?,?,?,?,?,?,?)');
   $s->execute([$n,$a,$username,$email,$h,$phone,$role]);
   $id=(int)db()->lastInsertId();
   out(['ok'=>true,'user'=>['id_usuario'=>$id,'nombres'=>$n,'apellidos'=>$a,'usuario'=>$username,'correo'=>$email,'telefono'=>$phone,'role'=>$role]],201);
