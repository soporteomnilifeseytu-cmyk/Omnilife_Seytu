<?php
// API sencilla para conectar OMNILIFE × SEYTÚ con MariaDB.
// Coloca este archivo en backend/api.php.
header('Content-Type: application/json; charset=utf-8');
header('Cache-Control: no-store, no-cache, must-revalidate, max-age=0');
// La API no usa cookies/sesiones en el navegador, por lo que puede aceptar
// peticiones desde el catálogo en PC y desde celulares/tablets.
header('Access-Control-Allow-Origin: *');
header('Access-Control-Allow-Headers: Content-Type');
header('Access-Control-Allow-Methods: GET, POST, OPTIONS');
if(($_SERVER['REQUEST_METHOD']??'GET')==='OPTIONS'){http_response_code(204);exit;}

$config = [
    'host' => '127.0.0.1',
    'db'   => 'omnilife_seytu',
    'user' => 'root',
    'pass' => '',
    'mail_from' => 'no-reply@localhost',
    'base_url' => 'http://localhost/final_omnilife/',
    'smtp_enabled' => false,
    'smtp_host' => 'smtp.gmail.com',
    'smtp_port' => 587,
    'smtp_user' => '',
    'smtp_pass' => '',
    'dev_reset_code' => true,
];
$configFile=__DIR__.'/config.php';
if(is_file($configFile)){ $extra=require $configFile; if(is_array($extra)) $config=array_merge($config,$extra); }

function out($data, $code=200){ http_response_code($code); echo json_encode($data, JSON_UNESCAPED_UNICODE); exit; }
function body(){ $raw=file_get_contents('php://input'); $j=json_decode($raw,true); return is_array($j)?$j:$_POST; }
function db(){ global $config; static $pdo=null; if($pdo)return $pdo; try{$pdo=new PDO("mysql:host={$config['host']};dbname={$config['db']};charset=utf8mb4",$config['user'],$config['pass'],[PDO::ATTR_ERRMODE=>PDO::ERRMODE_EXCEPTION,PDO::ATTR_DEFAULT_FETCH_MODE=>PDO::FETCH_ASSOC]);return $pdo;}catch(Throwable $e){out(['ok'=>false,'message'=>'Error de conexión','detalle'=>$e->getMessage()],500);} }
function ensureUserUsernameColumn(){
  static $done=false;
  if($done)return;
  $pdo=db();
  $exists=$pdo->query("SELECT COUNT(*) FROM information_schema.COLUMNS WHERE TABLE_SCHEMA=DATABASE() AND TABLE_NAME='usuarios' AND COLUMN_NAME='usuario'")->fetchColumn();
  if(!$exists){
    $pdo->exec("ALTER TABLE usuarios ADD COLUMN usuario VARCHAR(30) NULL AFTER apellidos");
    $pdo->exec("UPDATE usuarios SET usuario=LOWER(SUBSTRING_INDEX(correo,'@',1)) WHERE usuario IS NULL OR usuario=''");
    $pdo->exec("ALTER TABLE usuarios ADD UNIQUE KEY uq_usuarios_usuario (usuario)");
  }
  $done=true;
}
function ensureUserRoleColumn(){
  static $done=false; if($done)return; $pdo=db();
  $exists=$pdo->query("SELECT COUNT(*) FROM information_schema.COLUMNS WHERE TABLE_SCHEMA=DATABASE() AND TABLE_NAME='usuarios' AND COLUMN_NAME='rol'")->fetchColumn();
  if(!$exists){ $pdo->exec("ALTER TABLE usuarios ADD COLUMN rol VARCHAR(20) NOT NULL DEFAULT 'cliente' AFTER clave"); }
  $done=true;
}
function ensureAdminSchema(){
  static $done=false;
  if($done)return;
  $pdo=db();
  $checks=[
    ['usuarios','usuario',"ALTER TABLE usuarios ADD COLUMN usuario VARCHAR(30) NULL AFTER apellidos"],
    ['usuarios','rol',"ALTER TABLE usuarios ADD COLUMN rol VARCHAR(20) NOT NULL DEFAULT 'cliente' AFTER clave"],
    ['productos','marca',"ALTER TABLE productos ADD COLUMN marca VARCHAR(20) NOT NULL DEFAULT 'OMNILIFE' AFTER nombre"],
    ['productos','categoria',"ALTER TABLE productos ADD COLUMN categoria VARCHAR(100) NOT NULL DEFAULT 'General' AFTER marca"],
    ['productos','descripcion',"ALTER TABLE productos ADD COLUMN descripcion TEXT NULL AFTER categoria"],
    ['productos','precio',"ALTER TABLE productos ADD COLUMN precio DECIMAL(10,2) NOT NULL DEFAULT 0 AFTER descripcion"],
    ['productos','stock',"ALTER TABLE productos ADD COLUMN stock INT NOT NULL DEFAULT 0 AFTER precio"],
    ['productos','imagen',"ALTER TABLE productos ADD COLUMN imagen VARCHAR(255) NULL AFTER stock"],
    ['productos','estado',"ALTER TABLE productos ADD COLUMN estado VARCHAR(20) NOT NULL DEFAULT 'Disponible' AFTER imagen"]
  ];
  foreach($checks as $c){
    $q=$pdo->prepare("SELECT COUNT(*) FROM information_schema.COLUMNS WHERE TABLE_SCHEMA=DATABASE() AND TABLE_NAME=? AND COLUMN_NAME=?");
    $q->execute([$c[0],$c[1]]);
    if(!(int)$q->fetchColumn()) $pdo->exec($c[2]);
  }
  $q=$pdo->query("SELECT COUNT(*) FROM information_schema.STATISTICS WHERE TABLE_SCHEMA=DATABASE() AND TABLE_NAME='usuarios' AND COLUMN_NAME='usuario' AND NON_UNIQUE=0");
  if(!(int)$q->fetchColumn()){
    try{$pdo->exec("ALTER TABLE usuarios ADD UNIQUE KEY uq_usuarios_usuario (usuario)");}catch(Throwable $e){}
  }
  // Marca explícita para separar OMNILIFE y SEYTÚ, y tabla de categorías administrables.
  try{
    $pdo->exec("CREATE TABLE IF NOT EXISTS categorias_producto (id_categoria INT AUTO_INCREMENT PRIMARY KEY, marca VARCHAR(20) NOT NULL, nombre VARCHAR(100) NOT NULL, UNIQUE KEY uq_categoria_marca (marca,nombre)) ENGINE=InnoDB DEFAULT CHARSET=utf8mb4");
    $pdo->exec("UPDATE productos SET marca=CASE WHEN id_producto BETWEEN 1 AND 30 THEN 'OMNILIFE' WHEN id_producto BETWEEN 31 AND 60 THEN 'SEYTÚ' ELSE marca END WHERE marca IS NULL OR marca='' OR id_producto BETWEEN 1 AND 60");
    $rows=$pdo->query("SELECT DISTINCT marca,categoria FROM productos WHERE categoria IS NOT NULL AND TRIM(categoria)<>''")->fetchAll();
    $ins=$pdo->prepare("INSERT IGNORE INTO categorias_producto(marca,nombre) VALUES(?,?)");
    foreach($rows as $row) $ins->execute([$row['marca'],$row['categoria']]);
  }catch(Throwable $e){}
  $done=true;
}

function ensureAdminAccount(){
  static $done=false;
  if($done)return;
  ensureAdminSchema();
  $pdo=db();
  $q=$pdo->prepare("SELECT id_usuario FROM usuarios WHERE LOWER(usuario)='admin' OR LOWER(correo)='admin@omnilife.local' LIMIT 1");
  $q->execute();
  $id=$q->fetchColumn();
  if(!$id){
    $hash=password_hash('admin',PASSWORD_DEFAULT);
    $s=$pdo->prepare("INSERT INTO usuarios(nombres,apellidos,usuario,correo,clave,rol) VALUES(?,?,?,?,?,?)");
    $s->execute(['Administrador','', 'admin','admin@omnilife.local',$hash,'admin']);
  }else{
    $pdo->prepare("UPDATE usuarios SET usuario='admin', rol='admin' WHERE id_usuario=?")->execute([(int)$id]);
  }
  // Favorites must exist even when an older database was imported.
  $pdo->exec("CREATE TABLE IF NOT EXISTS favoritos (
    id_favorito INT NOT NULL AUTO_INCREMENT PRIMARY KEY,
    id_usuario INT NOT NULL,
    id_producto INT NOT NULL,
    fecha_guardado DATETIME DEFAULT CURRENT_TIMESTAMP,
    UNIQUE KEY uq_favorito (id_usuario,id_producto)
  ) ENGINE=InnoDB DEFAULT CHARSET=utf8mb4");
  $done=true;
}

function adminDbCheck(){
  try{
    ensureAdminSchema();
    $pdo=db();
    $dbName=$pdo->query('SELECT DATABASE()')->fetchColumn();
    $products=(int)$pdo->query('SELECT COUNT(*) FROM productos')->fetchColumn();
    $users=(int)$pdo->query('SELECT COUNT(*) FROM usuarios')->fetchColumn();
    out(['ok'=>true,'connected'=>true,'database'=>$dbName,'products'=>$products,'users'=>$users,'message'=>'MySQL conectado correctamente.']);
  }catch(Throwable $e){out(['ok'=>false,'connected'=>false,'message'=>'No se pudo conectar a MySQL.','detalle'=>$e->getMessage()],500);}
}

function userById($id){ensureUserUsernameColumn();ensureUserRoleColumn();ensureProfileColumns();$s=db()->prepare('SELECT id_usuario,nombres,apellidos,correo,telefono,usuario,rol,avatar FROM usuarios WHERE id_usuario=?');$s->execute([$id]);return $s->fetch();}
function userByEmail($email){ensureUserUsernameColumn();ensureUserRoleColumn();$s=db()->prepare('SELECT * FROM usuarios WHERE LOWER(correo)=LOWER(?)');$s->execute([$email]);return $s->fetch();}
function ensureProfileColumns(){static $done=false;if($done)return;$pdo=db();$has=$pdo->query("SELECT COUNT(*) FROM information_schema.COLUMNS WHERE TABLE_SCHEMA=DATABASE() AND TABLE_NAME='usuarios' AND COLUMN_NAME='avatar'")->fetchColumn();if(!$has)$pdo->exec("ALTER TABLE usuarios ADD COLUMN avatar VARCHAR(255) NULL");$done=true;}
function ensureOrderColumns(){static $done=false;if($done)return;$pdo=db();$has=$pdo->query("SELECT COUNT(*) FROM information_schema.COLUMNS WHERE TABLE_SCHEMA=DATABASE() AND TABLE_NAME='pedidos' AND COLUMN_NAME='visto'")->fetchColumn();if(!$has)$pdo->exec("ALTER TABLE pedidos ADD COLUMN visto TINYINT(1) NOT NULL DEFAULT 0");$done=true;}
function ensureResetColumns(){
  static $done=false; if($done)return; $pdo=db();
  $has=$pdo->query("SELECT COUNT(*) FROM information_schema.COLUMNS WHERE TABLE_SCHEMA=DATABASE() AND TABLE_NAME='usuarios' AND COLUMN_NAME='reset_codigo'")->fetchColumn();
  if(!$has){
    $pdo->exec("ALTER TABLE usuarios ADD COLUMN reset_codigo VARCHAR(10) NULL, ADD COLUMN reset_expira DATETIME NULL");
  }
  $done=true;
}
function smtpRead($fp,$expected){
  $line=''; while(!feof($fp)){ $line=fgets($fp,515); if($line===false) break; if(isset($line[3]) && $line[3]===' ') break; }
  $code=(int)substr(trim($line),0,3); if($expected!==null && $code!==$expected) throw new Exception('SMTP: '.trim($line));
  return $line;
}
function smtpWrite($fp,$cmd,$expected){ fwrite($fp,$cmd."\r\n"); return smtpRead($fp,$expected); }
function sendResetEmail($to,$code){
  global $config;
  $subject='Código para recuperar tu contraseña - OMNILIFE × SEYTÚ';
  $message="Hola\r\n\r\nTu código de recuperación es: {$code}\r\n\r\nEste código vence en 15 minutos. Si no solicitaste este cambio, ignora este mensaje.\r\n\r\nOMNILIFE × SEYTÚ";
  if(!empty($config['smtp_enabled']) && !empty($config['smtp_host']) && !empty($config['smtp_user']) && !empty($config['smtp_pass'])){
    try{
      $fp=stream_socket_client('tcp://'.$config['smtp_host'].':'.(int)$config['smtp_port'],$errno,$errstr,15,STREAM_CLIENT_CONNECT);
      if(!$fp) throw new Exception($errstr ?: 'No se pudo conectar con SMTP.');
      stream_set_timeout($fp,15); smtpRead($fp,220); smtpWrite($fp,'EHLO localhost',250);
      if(!empty($config['smtp_port']) && (int)$config['smtp_port']===587){ smtpWrite($fp,'STARTTLS',220); if(!stream_socket_enable_crypto($fp,true,STREAM_CRYPTO_METHOD_TLS_CLIENT)) throw new Exception('No se pudo activar TLS.'); smtpWrite($fp,'EHLO localhost',250); }
      smtpWrite($fp,'AUTH LOGIN',334); smtpWrite($fp,base64_encode($config['smtp_user']),334); smtpWrite($fp,base64_encode($config['smtp_pass']),235);
      smtpWrite($fp,'MAIL FROM:<'.$config['smtp_user'].'>',250); smtpWrite($fp,'RCPT TO:<'.$to.'>',250); smtpWrite($fp,'DATA',354);
      $headers='From: '.$config['smtp_user'].'\r\nTo: '.$to.'\r\nSubject: '.$subject.'\r\nMIME-Version: 1.0\r\nContent-Type: text/plain; charset=UTF-8\r\n';
      fwrite($fp,$headers.'\r\n'.$message."\r\n.\r\n"); smtpRead($fp,250); smtpWrite($fp,'QUIT',221); fclose($fp); return true;
    }catch(Throwable $e){ error_log('SMTP reset: '.$e->getMessage()); }
  }
  $headers='From: '.$config['mail_from'].'\r\nContent-Type: text/plain; charset=UTF-8\r\n';
  return @mail($to,$subject,$message,$headers);
}


$action=$_GET['action']??'';
try {
 
function canonicalProductImage($id,$fallback=''){
  $id=(int)$id;
  $fallback=trim((string)$fallback);
  // Prefer the image explicitly saved in MySQL (including uploaded images).
  if($fallback!==''){
    if(preg_match('#^https?://#i',$fallback)) return $fallback;
    $fullFallback=__DIR__.'/../'.ltrim($fallback,'/');
    if(is_file($fullFallback)) return $fallback;
  }
  $path='assets/IMG/imagen-'.str_pad((string)$id,2,'0',STR_PAD_LEFT).'.png';
  $full=__DIR__.'/../'.$path;
  return ($id>=1 && $id<=60 && is_file($full)) ? $path : '';
}
if($action==='login'){
   $b=body();$id=strtolower(trim($b['identifier']??''));$pass=(string)($b['password']??'');
   if($id===''||$pass==='')out(['ok'=>false,'message'=>'Completa usuario y contraseña.'],422);
   ensureAdminAccount();
   ensureUserUsernameColumn(); ensureUserRoleColumn(); ensureProfileColumns();
   $s=db()->prepare('SELECT * FROM usuarios WHERE LOWER(correo)=? OR LOWER(usuario)=? OR LOWER(SUBSTRING_INDEX(correo,"@",1))=? LIMIT 1');$s->execute([$id,$id,$id]);$u=$s->fetch();
   if(!$u)out(['ok'=>false,'message'=>'Usuario o contraseña incorrectos.'],401);
   $valid=password_verify($pass,$u['clave']) || hash_equals((string)$u['clave'],$pass);
   if(!$valid)out(['ok'=>false,'message'=>'Usuario o contraseña incorrectos.'],401);
   if(password_needs_rehash($u['clave'],PASSWORD_DEFAULT)){ $h=password_hash($pass,PASSWORD_DEFAULT);db()->prepare('UPDATE usuarios SET clave=? WHERE id_usuario=?')->execute([$h,$u['id_usuario']]); }
   $role=($u['rol']??'cliente');
   out(['ok'=>true,'admin'=>$role==='admin','user'=>['id_usuario'=>(int)$u['id_usuario'],'nombres'=>$u['nombres'],'apellidos'=>$u['apellidos'],'correo'=>$u['correo'],'usuario'=>($u['usuario']?:strtolower(strtok($u['correo'],'@'))),'role'=>$role]]);
 }
 if($action==='register'){
   $b=body();$n=trim($b['nombres']??'');$a=trim($b['apellidos']??'');$username=strtolower(trim($b['usuario']??''));$email=strtolower(trim($b['correo']??''));$phone=trim($b['telefono']??'');$pass=(string)($b['clave']??'');
   ensureUserUsernameColumn(); ensureUserRoleColumn();
   if(!$n||!$a||!preg_match('/^[a-z0-9._-]{3,30}$/',$username)||!filter_var($email,FILTER_VALIDATE_EMAIL)||!preg_match('/^[0-9+()\s-]{7,20}$/',$phone)||strlen($pass)<6)out(['ok'=>false,'message'=>'Completa todos los datos, incluido el número telefónico, y usa una contraseña de mínimo 6 caracteres.'],422);
   if(userByEmail($email))out(['ok'=>false,'message'=>'Ese correo ya está registrado.'],409);$q=db()->prepare('SELECT id_usuario FROM usuarios WHERE LOWER(usuario)=?');$q->execute([$username]);if($q->fetch())out(['ok'=>false,'message'=>'Ese usuario ya está registrado.'],409);
   $h=password_hash($pass,PASSWORD_DEFAULT);$s=db()->prepare("INSERT INTO usuarios(nombres,apellidos,usuario,correo,clave,telefono,rol) VALUES(?,?,?,?,?,?,?)");$s->execute([$n,$a,$username,$email,$h,$phone,'cliente']);$id=(int)db()->lastInsertId();
   out(['ok'=>true,'user'=>['id_usuario'=>$id,'nombres'=>$n,'apellidos'=>$a,'correo'=>$email,'telefono'=>$phone,'usuario'=>$username]],201);
 }
 if($action==='update_profile'){ensureUserUsernameColumn();ensureUserRoleColumn();ensureProfileColumns();$b=body();$id=(int)($b['id_usuario']??0);$n=trim($b['nombres']??'');$a=trim($b['apellidos']??'');$username=strtolower(trim($b['usuario']??''));$email=strtolower(trim($b['correo']??''));if(!$id||!$n||!$a||!preg_match('/^[a-z0-9._-]{3,30}$/',$username)||!filter_var($email,FILTER_VALIDATE_EMAIL))out(['ok'=>false,'message'=>'Datos inválidos.'],422);$q=db()->prepare('SELECT id_usuario FROM usuarios WHERE LOWER(usuario)=? AND id_usuario<>?');$q->execute([$username,$id]);if($q->fetch())out(['ok'=>false,'message'=>'Ese usuario ya está registrado.'],409);$q=db()->prepare('SELECT id_usuario FROM usuarios WHERE LOWER(correo)=? AND id_usuario<>?');$q->execute([$email,$id]);if($q->fetch())out(['ok'=>false,'message'=>'Ese correo ya está registrado.'],409);db()->prepare('UPDATE usuarios SET nombres=?,apellidos=?,usuario=?,correo=? WHERE id_usuario=?')->execute([$n,$a,$username,$email,$id]);$u=userById($id);out(['ok'=>true,'user'=>$u]);}
 if($action==='change_password'){ensureUserUsernameColumn();$b=body();$id=(int)($b['id_usuario']??0);$cur=(string)($b['current_password']??'');$new=(string)($b['new_password']??'');$u=userById($id);if(!$u||strlen($new)<6)out(['ok'=>false,'message'=>'Datos inválidos.'],422);$s=db()->prepare('SELECT clave FROM usuarios WHERE id_usuario=?');$s->execute([$id]);$row=$s->fetch();if(!$row||(password_verify($cur,$row['clave'])===false&&$cur!==(string)$row['clave']))out(['ok'=>false,'message'=>'La contraseña actual no coincide.'],401);db()->prepare('UPDATE usuarios SET clave=? WHERE id_usuario=?')->execute([password_hash($new,PASSWORD_DEFAULT),$id]);out(['ok'=>true,'message'=>'Contraseña actualizada correctamente.']);}
 if($action==='remove_user_avatar'){ensureProfileColumns();$id=(int)(body()['id_usuario']??0);if(!$id)out(['ok'=>false,'message'=>'Usuario requerido.'],422);db()->prepare('UPDATE usuarios SET avatar=NULL WHERE id_usuario=?')->execute([$id]);out(['ok'=>true]);}
 if($action==='forgot_request'){
   ensureResetColumns();
   $b=body(); $email=strtolower(trim($b['correo']??''));
   if(!filter_var($email,FILTER_VALIDATE_EMAIL))out(['ok'=>false,'message'=>'Ingresa un correo válido.'],422);
   $u=userByEmail($email);
   if(!$u)out(['ok'=>false,'message'=>'No encontramos una cuenta con ese correo.'],404);
   $code=(string)random_int(100000,999999);
   db()->prepare('UPDATE usuarios SET reset_codigo=?, reset_expira=DATE_ADD(NOW(), INTERVAL 15 MINUTE) WHERE id_usuario=?')->execute([$code,$u['id_usuario']]);
   $sent=sendResetEmail($email,$code);
   if(!$sent){
      if(!empty($config['dev_reset_code'])) out(['ok'=>true,'message'=>'Modo de prueba local: no se pudo enviar Gmail, pero el código está listo para probar.','dev_code'=>$code]);
      out(['ok'=>false,'message'=>'No se pudo enviar el correo. Configura SMTP en backend/config.php y vuelve a intentarlo.'],500);
   }
   out(['ok'=>true,'message'=>'Código enviado. Revisa tu correo.']);
 }
 if($action==='reset_password'){
   ensureResetColumns();
   $b=body(); $email=strtolower(trim($b['correo']??'')); $code=trim((string)($b['codigo']??'')); $pass=(string)($b['clave']??'');
   if(!filter_var($email,FILTER_VALIDATE_EMAIL)||!preg_match('/^\d{6}$/',$code)||strlen($pass)<6)out(['ok'=>false,'message'=>'Completa el código y usa una contraseña de mínimo 6 caracteres.'],422);
   $s=db()->prepare('SELECT id_usuario FROM usuarios WHERE LOWER(correo)=LOWER(?) AND reset_codigo=? AND reset_expira>=NOW() LIMIT 1');$s->execute([$email,$code]);$u=$s->fetch();
